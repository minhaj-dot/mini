<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ledger &amp; Leaf — Expense Tracker</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Bootstrap grid/utilities are available via CDN if needed for finer layout tweaks -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="dashboard">
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="index.html">
        <span class="brand-mark">Ledger &amp; Leaf</span>
        <span class="brand-sub">Personal expense tracker</span>
      </a>
      <nav class="site-nav">
        <a href="index.html" data-page="dashboard">Dashboard</a>
        <a href="pages/reports.html" data-page="reports">Reports</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Balance hero -->
    <section class="hero">
      <div class="wrap">
        <p class="hero-label">Current balance</p>
        <p class="hero-balance" id="balance-figure">Rs 0.00</p>
        <div class="hero-stats">
          <div class="hero-stat">
            <p class="hero-stat-label">Total income</p>
            <p class="hero-stat-value income" id="total-income">Rs 0.00</p>
          </div>
          <div class="hero-stat">
            <p class="hero-stat-label">Total expenses</p>
            <p class="hero-stat-value expense" id="total-expense">Rs 0.00</p>
          </div>
          <div class="hero-stat">
            <p class="hero-stat-label">Entries recorded</p>
            <p class="hero-stat-value" id="total-count">0</p>
          </div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <!-- Add / edit transaction -->
      <section class="section panel">
        <div class="panel-header">
          <h2 class="panel-title" id="form-title">Add a transaction</h2>
        </div>
        <div class="panel-body">
          <form id="transaction-form" novalidate>
            <input type="hidden" id="transaction-id" value="" />

            <div class="field-grid">
              <div class="field span-2">
                <label for="type-toggle-group">Type</label>
                <div class="type-toggle" id="type-toggle-group">
                  <button type="button" data-type="expense" class="active">Expense</button>
                  <button type="button" data-type="income">Income</button>
                </div>
                <input type="hidden" id="type" value="expense" />
              </div>

              <div class="field span-2">
                <label for="amount">Amount (Rs)</label>
                <input type="number" id="amount" min="0.01" step="0.01" placeholder="0.00" required />
                <span class="field-error" id="amount-error" style="color:#a6402a;font-size:12px;"></span>
              </div>

              <div class="field span-2">
                <label for="date">Date</label>
                <input type="date" id="date" required />
                <span class="field-error" id="date-error" style="color:#a6402a;font-size:12px;"></span>
              </div>

              <div class="field span-3">
                <label for="description">Description</label>
                <input type="text" id="description" placeholder="e.g. Grocery run at Metro" required />
                <span class="field-error" id="description-error" style="color:#a6402a;font-size:12px;"></span>
              </div>

              <div class="field span-3">
                <label for="category">Category</label>
                <select id="category" required></select>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="submit-btn">Add transaction</button>
              <button type="button" class="btn btn-ghost" id="cancel-edit-btn" style="display:none;">
                Cancel edit
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- Ledger -->
      <section class="section panel">
        <div class="panel-header">
          <h2 class="panel-title">Transactions</h2>
        </div>

        <div class="filters">
          <input type="text" id="search-input" placeholder="Search description…" />
          <select id="filter-type">
            <option value="all">All types</option>
            <option value="income">Income</option>
            <option value="expense">Expense</option>
          </select>
          <select id="filter-category">
            <option value="all">All categories</option>
          </select>
          <select id="sort-by">
            <option value="date-desc">Newest first</option>
            <option value="date-asc">Oldest first</option>
            <option value="amount-desc">Amount: high to low</option>
            <option value="amount-asc">Amount: low to high</option>
          </select>
        </div>

        <div class="table-scroll">
          <table class="ledger" id="ledger-table">
            <thead>
              <tr>
                <th>Description</th>
                <th>Category</th>
                <th>Date</th>
                <th class="num">Amount</th>
                <th class="num">Actions</th>
              </tr>
            </thead>
            <tbody id="ledger-body">
              <!-- Rows injected by js/script.js -->
            </tbody>
          </table>
        </div>

        <div class="empty-state" id="empty-state" style="display:none;">
          <p class="empty-title">No transactions yet</p>
          <p>Add your first income or expense above to start building your ledger.</p>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">Ledger &amp; Leaf — data stays on this device via Local Storage.</div>
  </footer>

  <script src="js/storage.js"></script>
  <script src="js/ui.js"></script>
  <script src="js/script.js"></script>
</body>
</html>