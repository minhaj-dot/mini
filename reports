<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reports — Ledger &amp; Leaf</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  />
  <link rel="stylesheet" href="../css/style.css" />
</head>
<body data-page="reports">
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="../index.html">
        <span class="brand-mark">Ledger &amp; Leaf</span>
        <span class="brand-sub">Personal expense tracker</span>
      </a>
      <nav class="site-nav">
        <a href="../index.html" data-page="dashboard">Dashboard</a>
        <a href="reports.html" data-page="reports">Reports</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="hero-label">Reports</p>
        <p class="hero-balance" style="font-size: clamp(28px, 5vw, 40px);">
          Where your money moves
        </p>
      </div>
    </section>

    <div class="wrap">
      <section class="section panel">
        <div class="panel-header">
          <h2 class="panel-title">Spending by category</h2>
        </div>
        <div class="panel-body">
          <div class="report-grid" id="category-report-grid">
            <div class="chart-canvas-wrap">
              <canvas id="category-chart"></canvas>
            </div>
            <ul class="legend-list" id="category-legend"></ul>
          </div>
          <div class="empty-state" id="category-empty" style="display:none;">
            <p class="empty-title">No expenses recorded yet</p>
            <p>Add an expense from the dashboard to see the breakdown here.</p>
          </div>
        </div>
      </section>

      <section class="section panel">
        <div class="panel-header">
          <h2 class="panel-title">Income vs. expenses by month</h2>
        </div>
        <div class="panel-body">
          <div class="chart-canvas-wrap" id="monthly-chart-wrap">
            <canvas id="monthly-chart"></canvas>
          </div>
          <div class="empty-state" id="monthly-empty" style="display:none;">
            <p class="empty-title">Nothing to chart yet</p>
            <p>Once you log a few transactions, monthly trends will show up here.</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">Ledger &amp; Leaf — data stays on this device via Local Storage.</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="../js/storage.js"></script>
  <script src="../js/ui.js"></script>
  <script src="../js/reports.js"></script>
</body>
</html>